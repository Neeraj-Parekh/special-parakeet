  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderIn": {
        "properties": {
          "order_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Order Id"
          },
          "amount_inr": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 1.0,
            "title": "Amount Inr"
          },
          "category": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2,
            "title": "Category"
          },
          "customer_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Customer Id"
          },
          "address_quality": {
            "type": "string",
            "pattern": "^(complete|partial|vague)$",
            "title": "Address Quality",
            "default": "complete"
          },
          "city_tier": {
            "type": "string",
            "pattern": "^tier_[123]$",
            "title": "City Tier",
            "default": "tier_2"
          },
          "payment_method": {
            "type": "string",
            "maxLength": 16,
            "pattern": "^(COD|Prepaid)$",
            "title": "Payment Method",
            "default": "COD"
          },
          "prior_orders": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Prior Orders",
            "default": 0
          },
          "prior_returns": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Prior Returns",
            "default": 0
          },
          "items": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Items",
            "default": 1
          },
          "order_hour": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Order Hour",
            "default": 12
          },
          "device": {
            "type": "string",
            "maxLength": 32,
            "title": "Device",
            "default": "Android App"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "amount_inr",
          "category",
          "customer_id"
        ],
        "title": "OrderIn"
      },
      "RuleIn": {
        "properties": {
          "rule_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "title": "Rule Id"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Name"
          },
          "field": {
            "type": "string",
            "maxLength": 48,
            "title": "Field"
          },
          "op": {
            "type": "string",
            "pattern": "^(gt|lt|eq|in)$",
            "title": "Op"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Value"
          },
          "action": {
            "type": "string",
